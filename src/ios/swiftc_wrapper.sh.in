#!/bin/bash
# Wrapper for swiftc to filter/transform incompatible C++ linker flags.
# Swift doesn't understand -pthread or -Wl, style flags.

args=()
for arg in "$@"; do
  # Filter pthread flags
  if [[ "$arg" == "-pthread" ]] || [[ "$arg" == "-lpthread" ]]; then
    continue
  # Transform -Wl, flags to -Xlinker format
  elif [[ "$arg" == -Wl,* ]]; then
    # Remove -Wl, prefix and split by comma
    wl_content="${arg#-Wl,}"
    IFS=',' read -ra parts <<< "$wl_content"
    for part in "${parts[@]}"; do
      if [[ -n "$part" ]]; then
        args+=("-Xlinker" "$part")
      fi
    done
  else
    args+=("$arg")
  fi
done

# Call actual swiftc with transformed arguments
exec /usr/bin/swiftc "${args[@]}"
